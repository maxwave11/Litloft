{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "default_locale": "en",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Add to Litloft", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "128": "icons/icon-128.png" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{
    "resources": ["lib/video.js", "lib/picker.js", "lib/picker-view.js", "styles/picker.css"],
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"]
  }]
}
